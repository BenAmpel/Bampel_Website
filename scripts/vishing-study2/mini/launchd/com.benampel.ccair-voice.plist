<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- CCAIR lab voice (Kokoro TTS, voice_server.py) on the lab Mac mini, bound to its Tailscale address.
     The Python environment lives on the Extreme SSD; if the SSD is not mounted yet, the start fails and KeepAlive
     retries every 30 s. Installed by install.sh in this folder. -->
<plist version="1.0"><dict>
<key>Label</key><string>com.benampel.ccair-voice</string>
<key>ProgramArguments</key><array>
  <string>/Volumes/Extreme SSD/_tools/kokoro/venv/bin/python</string>
  <string>/Users/benampel/ccair-voice/voice_server.py</string>
  <string>--host</string><string>100.85.210.3</string><string>--port</string><string>8179</string>
</array>
<key>WorkingDirectory</key><string>/Users/benampel/ccair-voice</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ThrottleInterval</key><integer>30</integer>
<key>StandardOutPath</key><string>/Users/benampel/Library/Logs/ccair-voice.log</string>
<key>StandardErrorPath</key><string>/Users/benampel/Library/Logs/ccair-voice.err</string>
</dict></plist>
